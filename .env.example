# ==============================================================================
# CONFIGURATION SUPABASE (FRONTEND VITE)
# ==============================================================================
# 1. Allez sur https://supabase.com et créez un projet gratuit (ou ouvrez l'existant)
# 2. Dans votre projet Supabase : Settings (icône engrenage) > Data API (ou API Settings)
# 3. Copiez "Project URL" dans VITE_SUPABASE_URL
# 4. Copiez la clé "anon" (public) dans VITE_SUPABASE_ANON_KEY
# 5. Ne mettez JAMAIS la clé service_role ici !
# ==============================================================================

VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_ANON_KEY=votre-cle-anon-publique-ici
