{
  "version": 1,
  "source": "src/index.css",
  "shadows": {
    "lift": "0 1px 2px rgba(11,11,12,.05), 0 6px 18px rgba(11,11,12,.06)",
    "lift-2": "0 2px 4px rgba(11,11,12,.05), 0 14px 36px rgba(11,11,12,.10)",
    "float": "0 10px 24px rgba(11,11,12,.22), 0 2px 6px rgba(11,11,12,.12)"
  },
  "motion": {
    "ease": "cubic-bezier(0.16, 1, 0.3, 1)",
