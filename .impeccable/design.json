    "fast": "140ms",
    "base": "260ms",
    "remotion": { "mosaic": "480 frames @30fps, boucle", "welcome": "150 frames @30fps, une fois" }
  },
  "breakpoints": { "tablet": "720px", "login-split": "960px", "desktop": "1040px" },
  "rules": [
    "Fond blanc pur partout",
    "Un seul accent violet, réservé au direct et à la sélection",
    "Choisir, c'est encrer : l'option choisie devient une carte noire",
    "Une pilule noire par écran pour l'action principale"
  ],
  "components": {
    "button-primary": "<button class=\"btn btn--ink btn--lg\">Continuer <span class=\"btn__knob\">→</span></button>",
    "chip": "<button class=\"chip\" aria-selected=\"true\">Invités · 3</button>",
    "askbar": "<div class=\"askbar\"><input class=\"askbar__input\" placeholder=\"Ton prénom\"><button class=\"askbar__go\">→</button></div>",
    "option": "<button class=\"option\" role=\"radio\" aria-checked=\"true\"><span class=\"option__emoji\">🎄</span><span class=\"option__body\"><span class=\"option__label\">Week-end du 25 Décembre</span></span><span class=\"option__check\">✓</span></button>"
  }
}
